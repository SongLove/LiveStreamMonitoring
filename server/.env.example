# App
NODE_ENV=development
APP_NAME=livestream-monitoring
API_PORT=4000
WORKER_MODE=false

# Mongo / Redis
# 本地 npm run start:api:dev 用 127.0.0.1；Docker Compose 内 api/worker 会自动覆盖为 mongo/redis
MONGODB_URI=mongodb://127.0.0.1:27017/livestream
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT
JWT_CLIENT_SECRET=change-me-client-jwt-secret-min-32-chars
JWT_ADMIN_SECRET=change-me-admin-jwt-secret-min-32-chars
JWT_CLIENT_EXPIRES=7d
JWT_ADMIN_EXPIRES=1d

# WeChat Mini Program
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=
WECHAT_SUBSCRIBE_TEMPLATE_ID=
WECHAT_MINI_PROGRAM_STATE=developer

# Quota
QUOTA_MAX_BALANCE=200

# Douyin third-party（TikHub）— 优先；未配置或失败时降级 Playwright 拉昵称/头像
# 接口: GET {BASE}/api/v1/douyin/web/handler_user_profile_v2?unique_id=抖音号
# 文档: https://docs.tikhub.io/232379586e0
DOUYIN_THIRD_PARTY_BASE_URL=https://api.tikhub.io
DOUYIN_THIRD_PARTY_API_KEY=

# Douyin Playwright 兜底（需: npx playwright install chromium）
DOUYIN_PW_TIMEOUT_MS=20000
DOUYIN_PW_CONCURRENCY=1
DOUYIN_PW_HEADLESS=true
# DOUYIN_PW_SMOKE=1  # 可选：开启真机 smoke 测试

# Admin bootstrap (dev only)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin123456

# Object storage (optional avatar mirror)
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=

# Holiday calendar
HOLIDAY_API_URL=https://timor.tech/api/holiday/year

# Bull Board (optional token for /admin/queues)
BULL_BOARD_TOKEN=

# Live state machine
LIVE_MIN_REBROADCAST_MINUTES=30
LIVE_CONFIRM_OFFLINE_POLLS=2
