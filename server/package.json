{
  "name": "livestream-monitoring-server",
  "version": "1.0.0",
  "description": "主播开播监控 Server (NestJS API + Worker)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start:api": "nest start --entryFile main.api",
    "start:api:dev": "nest start --watch --entryFile main.api",
    "start:worker": "nest start --entryFile main.worker",
    "start:worker:dev": "nest start --watch --entryFile main.worker",
    "start:prod:api": "node dist/main.api.js",
    "start:prod:worker": "node dist/main.worker.js",
    "dev:local": "bash scripts/dev-local.sh",
    "test": "jest --config ./jest.config.js --runInBand",
    "test:unit": "jest --config ./jest.config.js --runInBand --testPathPattern=spec.ts"
  },
  "dependencies": {
    "@bull-board/api": "^6.9.2",
    "@bull-board/express": "^6.9.2",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^6.0.0",
    "mongoose": "^9.9.3",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino-http": "^11.0.0",
    "playwright": "^1.62.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^10.0.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "5.7.3"
  }
}
